--- /dev/null
+++ b/src/domain/roverStats.ts
@@ -0,0 +1,37 @@
+/**
+ * Effective rover characteristics.
+ *
+ * Game Design v2 introduced per-attribute upgrade levels. The effective value
+ * of an attribute is the base value scaled by a fixed step per level:
+ *
+ *   effective = base * (1 + level * ROVER_UPGRADE_STEP)
+ *
+ * At level 0 the effective value equals the base value, so an un-upgraded rover
+ * behaves exactly like it did before v2. This module is pure: no React, Prisma,
+ * randomness or time.
+ */
+
+import { ROVER_UPGRADE_STEP } from './constants'
+import { assertFinite } from './errors'
+import { roundToInt } from './math'
+import type { Rover, RoverStats } from './types'
+
+function upgradeMultiplier(level: number): number {
+  assertFinite(level, 'rover upgrade level')
+  const safeLevel = level < 0 ? 0 : level
+  return 1 + safeLevel * ROVER_UPGRADE_STEP
+}
+
+/** Computes the effective rover characteristics from its base stats + levels. */
+export function computeRoverStats(rover: Rover): RoverStats {
+  return {
+    capacity: roundToInt(
+      rover.capacity * upgradeMultiplier(rover.capacityLevel),
+    ),
+    speed: rover.speed * upgradeMultiplier(rover.speedLevel),
+    efficiency: rover.efficiency * upgradeMultiplier(rover.efficiencyLevel),
+    batteryCapacity: roundToInt(
+      rover.batteryCapacity * upgradeMultiplier(rover.batteryLevel),
+    ),
+  }
+}
