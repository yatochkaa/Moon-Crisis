{
  "name": "moon-courier-crisis",
  "version": "0.1.0",
  "private": true,
  "description": "Moon Courier Crisis — strategic lunar delivery game (test assignment).",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:setup": "prisma migrate deploy && prisma generate && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "effect": "3.20.0",
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "dependencies": {
    "@prisma/client": "6.13.0",
    "next": "15.5.21",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.17.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.21",
    "eslint-config-prettier": "9.1.0",
    "postcss": "8.5.23",
    "prettier": "3.6.2",
    "prisma": "6.13.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  }
}
