# Copy this file to `.env` and keep `.env` out of version control.
#
# Local SQLite database file. The path is relative to the `prisma/` folder.
DATABASE_URL="file:./dev.db"

# Allows POST /api/game/reset outside of development.
# The reset endpoint is unauthenticated and destructive, therefore it stays
# disabled in production unless this flag is explicitly set to "true".
ALLOW_GAME_RESET="false"
